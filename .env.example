# ==========================================================
# Actos Line Trans — environment template.
# Copy this file to ".env" and fill in your real values.
#   cp .env.example .env       (macOS/Linux)
#   copy .env.example .env     (Windows)
# ==========================================================

# JWT signing key — MUST be a strong random value (the app refuses to start with
# a weak/placeholder key). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-long-random-secret-here
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin account — seeded into the users table on first run only.
# Use a strong password; this is the login for the admin dashboard.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-admin-password

# CORS — comma-separated list of allowed front-end origins. The UI is served
# from the same origin as the API, so you usually only need your deployed URL.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Server bind (the host injects PORT in production; keep HOST=0.0.0.0 for deploy)
HOST=0.0.0.0
PORT=8000

# Gmail SMTP — create a Google "App Password" (16 chars, no spaces)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
TARGET_EMAIL=your-email@gmail.com

# Email verification / reset code lifetime (minutes) and demo flag
CODE_TTL_MINUTES=10
DEMO_SHOW_CODES=false

# Groq LLM (free key from https://console.groq.com) — powers the smart chatbot
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=llama-3.1-8b-instant
